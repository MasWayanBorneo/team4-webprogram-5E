// ============================================================================
// Why Don't We — rancangan database situs (sama dengan why_dont_we.sql)
// Tempel seluruh isi file ini ke dbdiagram.io untuk melihat diagramnya.
// ============================================================================

Enum album_type {
  album
  ep
  single
}

Enum concert_region {
  asia
  america
  europe
  other
}

Enum concert_status {
  available   [note: 'tiket dijual → tombol Get Ticket']
  coming_soon [note: 'belum dijual → tombol Pre Order (pesanan pending)']
  sold_out
}

Enum order_status {
  pending   [note: 'pre-order yang belum dikonfirmasi panitia, belum ada tiket']
  paid      [note: 'lunas, PDF berisi tiket dengan sobekan']
  cancelled
}

Enum subscriber_source {
  home [note: 'form Sign up di halaman Home']
  news [note: 'form Subscribe di halaman News']
  tour [note: 'form Subscribe di halaman Tour']
}

// ---- Musik -----------------------------------------------------------------

Table albums {
  id            int          [pk, increment]
  title         varchar(150) [not null]
  type          album_type   [not null]
  release_year  year
  cover_image   varchar(255)
  Note: 'Kartu "All albums" di halaman Music'
}

Table songs {
  id            int          [pk, increment]
  album_id      int          [note: 'boleh kosong untuk single tanpa album']
  title         varchar(150) [not null]
  duration_sec  smallint
  audio_file    varchar(255)
  cover_image   varchar(255)
  lyrics        text         [note: 'disimpan sebagai HTML (<p class="verse">, <br>)']
  spotify_url   varchar(255) [note: 'link lagu ini di Spotify']
  apple_url     varchar(255) [note: 'link lagu ini di Apple Music']
  youtube_url   varchar(255) [note: 'link lagu ini di YouTube Music']
  is_featured   boolean      [not null, default: false, note: 'true = tampil di "Top popular songs"']
}

Table videos {
  id            int          [pk, increment]
  title         varchar(150) [not null]
  youtube_id    varchar(20)  [not null, unique, note: 'kode video YouTube']
  start_second  smallint     [not null, default: 0, note: 'detik awal video diputar']
}

// ---- Personel & fan club ---------------------------------------------------

Table members {
  id           int          [pk, increment]
  slug         varchar(50)  [not null, unique, note: 'nama pendek untuk URL: member.php?m=jonah']
  full_name    varchar(100) [not null]
  roles        varchar(100) [not null]
  birth_date   date
  zodiac       varchar(20)
  hometown     varchar(100)
  extra_label  varchar(50)  [note: 'judul fakta ke-4 yang beda tiap personel: Sports, Position, Instruments, Skills']
  extra_value  varchar(150) [note: 'isi fakta ke-4, mis. Baseball / Guitar, Cello, Piano']
  bio          text
  photo        varchar(255)
  hero_photo   varchar(255)
  sort_order   tinyint      [not null, default: 0, note: 'urutan tampil di halaman About']
}

Table member_trivia {
  id          int          [pk, increment]
  member_id   int          [not null]
  content     varchar(255) [not null]
  sort_order  tinyint      [not null, default: 0, note: 'urutan trivia di halaman personel']
}

Table limelight_members {
  id                  int          [pk, increment]
  full_name           varchar(100) [not null]
  email               varchar(100) [not null, unique]
  date_of_birth       date         [not null]
  favorite_member_id  int
  joined_at           timestamp    [not null, default: `now()`]
  Note: 'Pendaftar dari form Limelight (modal di halaman About)'
}

Table limelight_benefits {
  id           int          [pk, increment]
  icon         varchar(50)  [not null, note: 'nama ikon Font Awesome, mis. fa-ticket']
  title        varchar(100) [not null]
  description  varchar(255) [not null]
  sort_order   tinyint      [not null, default: 0, note: 'urutan tampil']
  is_active    boolean      [not null, default: true, note: 'false = disembunyikan tanpa dihapus']
  Note: 'Kartu benefit Limelight; benefit baru cukup ditambah sebagai baris baru'
}

// ---- Berita ----------------------------------------------------------------

Table news_categories {
  id    int         [pk, increment]
  name  varchar(50) [not null, unique]
}

Table news {
  id             int          [pk, increment]
  category_id    int          [not null]
  slug           varchar(150) [not null, unique, note: 'nama pendek untuk URL: article.php?slug=tour-dates-revealed']
  title          varchar(200) [not null]
  excerpt        varchar(300) [note: 'ringkasan 1–2 kalimat untuk kartu berita & meta description']
  content        mediumtext   [not null, note: 'isi artikel dalam HTML']
  thumbnail      varchar(255)
  read_time_min  tinyint
  is_featured    boolean      [not null, default: false, note: 'true = berita besar di atas halaman News']
  published_at   datetime
}

// ---- Tiket konser ----------------------------------------------------------

Table concerts {
  id          int            [pk, increment]
  venue_name  varchar(150)   [not null]
  city        varchar(100)   [not null]
  country     varchar(100)   [not null]
  region      concert_region [not null, note: 'tombol filter Asia / America / Europe / Other di halaman Tour']
  event_date  datetime       [not null]
  image       varchar(255)
  status      concert_status [not null, default: 'available']
}

Table ticket_categories {
  id           int           [pk, increment]
  concert_id   int           [not null]
  name         varchar(50)   [not null, note: 'Regular, VIP']
  description  varchar(255)
  price        decimal(12,2) [not null, note: 'harga yang berlaku sekarang']
  quota        int           [not null, note: 'pesanan pending & paid mengurangi kuota, cancelled tidak']
}

Table ticket_orders {
  id                  int           [pk, increment]
  invoice_no          varchar(30)   [not null, unique, note: 'format WDW-XXXXXXXX, juga isi QR di tiket']
  ticket_category_id  int           [not null]
  full_name           varchar(100)  [not null]
  email               varchar(100)  [not null]
  phone               varchar(20)   [not null]
  quantity            tinyint       [not null, note: 'jumlah orang = jumlah gelang di pintu masuk']
  unit_price          decimal(12,2) [not null, note: 'harga 1 tiket SAAT dipesan; tidak ikut berubah kalau ticket_categories.price naik']
  total               decimal(12,2) [not null, note: 'unit_price × quantity']
  status              order_status  [not null, default: 'pending', note: 'tiket biasa langsung paid; pre-order pending sampai dikonfirmasi']
  checked_in_at       datetime      [note: 'waktu tiket dipakai masuk (check-in panitia); kosong = belum dipakai, mencegah tiket dipakai dua kali']
  created_at          timestamp     [not null, default: `now()`]
}

// ---- Lain-lain -------------------------------------------------------------

Table products {
  id           int           [pk, increment]
  name         varchar(150)  [not null]
  collection   varchar(100)
  price        decimal(12,2) [not null]
  image        varchar(255)
  is_featured  boolean       [not null, default: false, note: 'true = juga tampil di kartu besar halaman Merch']
  is_active    boolean       [not null, default: true]
}

Table subscribers {
  id             int               [pk, increment]
  email          varchar(100)      [not null, unique]
  source         subscriber_source [not null]
  subscribed_at  timestamp         [not null, default: `now()`]
}

// ---- Admin -----------------------------------------------------------------

Table admins {
  id             int          [pk, increment]
  username       varchar(50)  [not null, unique]
  email          varchar(100) [not null, unique]
  password_hash  varchar(255) [not null, note: 'hasil password_hash(), bukan password asli']
  created_at     timestamp    [not null, default: `now()`]
  Note: 'Akun login dashboard admin (AdminLTE) untuk CRUD semua tabel; tidak berelasi dengan tabel lain'
}

// ---- Relasi (sama dengan FOREIGN KEY di SQL) -------------------------------

Ref: songs.album_id > albums.id [delete: set null]
Ref: member_trivia.member_id > members.id [delete: cascade]
Ref: limelight_members.favorite_member_id > members.id [delete: set null]
Ref: news.category_id > news_categories.id
Ref: ticket_categories.concert_id > concerts.id
Ref: ticket_orders.ticket_category_id > ticket_categories.id

// ---- Pengelompokan di diagram ----------------------------------------------

TableGroup musik {
  albums
  songs
  videos
}

TableGroup personel_dan_limelight {
  members
  member_trivia
  limelight_members
  limelight_benefits
}

TableGroup berita {
  news_categories
  news
}

TableGroup tiket_konser {
  concerts
  ticket_categories
  ticket_orders
}

TableGroup lain_lain {
  products
  subscribers
}

TableGroup admin {
  admins
}
